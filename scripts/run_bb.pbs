#!/bin/bash
# BB calculation - submit from run directory with: qsub -V run_bb.pbs
#PBS -N BB
#PBS -V
#PBS -q normal
#PBS -A inhouse
#PBS -l select=1:ncpus=64:mpiprocs=64:ompthreads=1
#PBS -l walltime=00:21:00
#PBS -W sandbox=PRIVATE

set +u
# Source the config
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$HOME/project/cw/quakecw_workflow/quakecw_config.sh"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: quakecw_config.sh not found at $CONFIG_FILE"
    exit 1
fi

source "$CONFIG_FILE"

# === Derive everything from submission directory ===
SUBMIT_DIR="${PBS_O_WORKDIR:-$PWD}"
REL_DIR="$SUBMIT_DIR"

get_param() {
    python -c "
from qcore.utils import load_sim_params
p = load_sim_params('${REL_DIR}/sim_params.yaml')
keys = '$1'.split('.')
for k in keys:
    p = p[k]
print(p)
"
}

RUN_NAME=$(get_param run_name)
FLO=$(get_param flo)
BB_FMIN=$(get_param "bb.fmin")
BB_FMIDBOT=$(get_param "bb.fmidbot")
BB_NO_LF_AMP=$(get_param "bb.no-lf-amp")
VS30_PATH=$(get_param stat_vs_est)

RUN_NAME=$(get_param run_name)
# Job naming
JOBNAME="BB.${RUN_NAME}"

## Rename the job (works after the job starts)
# qalter -N "$JOBNAME" "$PBS_JOBID" 2>/dev/null || true

JOB_ID_RAW=${PBS_JOBID%%.*}
CLEAN_ID=$(echo "$JOB_ID_RAW" | sed 's/\[/_/g; s/\]//g')
LOG_FILE="${REL_DIR}/${JOBNAME}.${CLEAN_ID}.log"


echo "Redirecting output to live log: $LOG_FILE"
exec > >(tee -a "$LOG_FILE") 2>&1





# FAULT_DIR is one level up from REL_DIR
FAULT_DIR=$(dirname "$REL_DIR")
FAULT_NAME=$(basename "$FAULT_DIR")
DATA_DIR=$(dirname "$(dirname "$FAULT_DIR")")/Data
VM_DIR=$(get_param vel_mod_dir)

# Paths
BB_SIM_SCRIPT="${QUAKECW}/scripts/bb_sim.py"
TEST_BB_SCRIPT="${QUAKECW}/test/test_bb.sh"

export SLURM_JOB_ID="${PBS_JOBID/.pbs/}"
export SLURM_NTASKS=$(qstat $SLURM_JOB_ID -f | grep "used.ncpus" | cut -d"=" -f2 | bc)
export SLURM_NNODES=$(qstat $SLURM_JOB_ID -f | grep "List.nodect" | cut -d"=" -f2 | bc)

start_time=$(date "+%Y-%m-%d_%H:%M:%S")
echo "Start: $start_time"
echo "REL_DIR: $REL_DIR"
echo "Run name: $RUN_NAME"

echo "Computing BB"
mkdir -p "${REL_DIR}/BB/Acc"

# Build optional --no-lf-amp flag
NO_LF_AMP_FLAG=""
if [[ "$BB_NO_LF_AMP" == "True" || "$BB_NO_LF_AMP" == "true" ]]; then
    NO_LF_AMP_FLAG="--no-lf-amp"
fi

echo mpirun python "$BB_SIM_SCRIPT" \
     "${REL_DIR}/LF/OutBin" \
     "$VM_DIR" \
     "${REL_DIR}/HF/Acc/HF.bin" \
     "$VS30_PATH" \
     "${REL_DIR}/BB/Acc/BB.bin" \
     --flo "$FLO" \
     --fmin "$BB_FMIN" \
     --fmidbot "$BB_FMIDBOT" \
     $NO_LF_AMP_FLAG

mpirun python "$BB_SIM_SCRIPT" \
    "${REL_DIR}/LF/OutBin" \
    "$VM_DIR" \
    "${REL_DIR}/HF/Acc/HF.bin" \
    "$VS30_PATH" \
    "${REL_DIR}/BB/Acc/BB.bin" \
    --flo "$FLO" \
    --fmin "$BB_FMIN" \
    --fmidbot "$BB_FMIDBOT" \
    $NO_LF_AMP_FLAG

EXIT_CODE=$?
end_time=$(date "+%Y-%m-%d_%H:%M:%S")
echo "End: $end_time"

# Verification
if [[ -f "$TEST_BB_SCRIPT" ]]; then
    res=$("$TEST_BB_SCRIPT" "$REL_DIR" 2>&1)
    if [[ $? == 0 ]]; then
        echo "SUCCESS: BB completed"
    else
        res=$(echo "$res" | tr -d '\n')
        echo "FAIL: BB failed: $res"
        exit 1
    fi
else
    echo "WARNING: test_bb.sh not found, skipping verification"
fi
